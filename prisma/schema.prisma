generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  SUPPORT
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING_DELETION
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum SiteStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  SUSPENDED
}

enum VersionKind {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BlockType {
  HEADER
  BUTTON
  SOCIAL_LINKS
  BANNER
  TEXT
  DIVIDER
  GOOGLE_REVIEW
  CONTACT
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIAL
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELED
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AnalyticsEventType {
  PAGE_VIEW
  LINK_CLICK
}

enum AuthTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
  EMAIL_CHANGE
}

enum DataRequestType {
  EXPORT_DATA
  DELETE_ACCOUNT
}

enum DataRequestStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  REJECTED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model User {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  passwordHash   String?
  emailVerified  DateTime?
  image          String?
  role           UserRole      @default(CUSTOMER)
  status         UserStatus    @default(ACTIVE)
  sessionVersion Int           @default(1)
  lastLoginAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  accounts       Account[]
  sessions       Session[]
  memberships    Membership[]
  authTokens     AuthToken[]
  auditLogs      AuditLog[]    @relation("AuditActor")
  dataRequests   DataRequest[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AuthToken {
  id         String        @id @default(cuid())
  userId     String
  type       AuthTokenType
  tokenHash  String        @unique
  newEmail   String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, expiresAt])
}

model Workspace {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  memberships       Membership[]
  sites             Site[]
  subscription      Subscription?
  auditLogs         AuditLog[]
  couponRedemptions CouponRedemption[]
}

model Membership {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Site {
  id                 String           @id @default(cuid())
  workspaceId        String
  name               String
  slug               String           @unique
  status             SiteStatus       @default(DRAFT)
  draftVersionId     String?          @unique
  publishedVersionId String?          @unique
  suspendedReason    String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  publishedAt        DateTime?
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions           SiteVersion[]    @relation("SiteVersions")
  draftVersion       SiteVersion?     @relation("SiteDraftVersion", fields: [draftVersionId], references: [id], onDelete: SetNull)
  publishedVersion   SiteVersion?     @relation("SitePublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  analyticsEvents    AnalyticsEvent[]

  @@index([workspaceId, updatedAt])
  @@index([status, publishedAt])
}

model SiteVersion {
  id          String      @id @default(cuid())
  siteId      String
  number      Int
  kind        VersionKind @default(DRAFT)
  config      Json
  createdAt   DateTime    @default(now())
  publishedAt DateTime?
  site        Site        @relation("SiteVersions", fields: [siteId], references: [id], onDelete: Cascade)
  draftOf     Site?       @relation("SiteDraftVersion")
  publishedOf Site?       @relation("SitePublishedVersion")
  blocks      SiteBlock[]
  theme       SiteTheme?

  @@unique([siteId, number])
  @@index([siteId, kind])
}

model SiteBlock {
  id        String      @id @default(cuid())
  versionId String
  key       String      @default(cuid())
  type      BlockType
  position  Int
  isVisible Boolean     @default(true)
  content   Json
  createdAt DateTime    @default(now())
  version   SiteVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, key])
  @@index([versionId, position])
}

model SiteTheme {
  id               String      @id @default(cuid())
  versionId        String      @unique
  primaryColor     String      @default("#3155D9")
  secondaryColor   String      @default("#E3EBFF")
  textColor        String      @default("#17213A")
  buttonColor      String      @default("#3155D9")
  buttonTextColor  String      @default("#FFFFFF")
  backgroundColor  String      @default("#F6F8FC")
  backgroundImage  String?
  font             String      @default("DM Sans")
  cornerRadius     Int         @default(16)
  spacing          Int         @default(16)
  buttonStyle      String      @default("solid")
  logoShape        String      @default("circle")
  showPlatformMark Boolean     @default(true)
  version          SiteVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
}

model Template {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  category     String
  description  String
  thumbnailUrl String?
  config       Json
  status       TemplateStatus @default(DRAFT)
  featured     Boolean        @default(false)
  position     Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  plans        TemplatePlan[]
}

model TemplatePlan {
  templateId String
  planId     String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([templateId, planId])
}

model Plan {
  id                String          @id @default(cuid())
  name              String
  slug              String          @unique
  description       String
  priceCents        Int
  currency          String          @default("BRL")
  interval          BillingInterval @default(MONTHLY)
  minisiteLimit     Int             @default(1)
  blockLimit        Int             @default(30)
  templateLimit     Int             @default(10)
  storageLimitMb    Int             @default(100)
  hasAnalytics      Boolean         @default(true)
  removableBranding Boolean         @default(false)
  customDomain      Boolean         @default(false)
  features          Json
  isActive          Boolean         @default(true)
  position          Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  subscriptions     Subscription[]
  templates         TemplatePlan[]
  couponPlans       CouponPlan[]
  payments          Payment[]
}

model Subscription {
  id                     String             @id @default(cuid())
  workspaceId            String             @unique
  planId                 String
  provider               String             @default("development")
  providerCustomerId     String?
  providerSubscriptionId String?            @unique
  status                 SubscriptionStatus @default(TRIAL)
  planNameSnapshot       String
  amountCents            Int
  currency               String             @default("BRL")
  interval               BillingInterval
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  trialEndsAt            DateTime?
  gracePeriodEndsAt      DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  workspace              Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan                   Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments               Payment[]
}

model Payment {
  id                String        @id @default(cuid())
  subscriptionId    String
  planId            String?
  couponId          String?
  provider          String
  providerPaymentId String
  status            PaymentStatus @default(PENDING)
  amountCents       Int
  discountCents     Int           @default(0)
  currency          String        @default("BRL")
  description       String?
  checkoutUrl       String?
  paidAt            DateTime?
  failureCode       String?
  refundedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  subscription      Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  plan              Plan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  coupon            Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@unique([provider, providerPaymentId])
  @@index([subscriptionId, createdAt])
  @@index([status, createdAt])
}

model PaymentEvent {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String    @unique
  eventType       String
  payloadHash     String
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  processingError String?
}

model Coupon {
  id                String             @id @default(cuid())
  code              String             @unique
  description       String?
  discountType      DiscountType
  discountValue     Int
  startsAt          DateTime?
  endsAt            DateTime?
  maxRedemptions    Int?
  perWorkspaceLimit Int                @default(1)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  plans             CouponPlan[]
  redemptions       CouponRedemption[]
  payments          Payment[]
}

model CouponPlan {
  couponId String
  planId   String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  plan     Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([couponId, planId])
}

model CouponRedemption {
  id          String    @id @default(cuid())
  couponId    String
  workspaceId String
  redeemedAt  DateTime  @default(now())
  coupon      Coupon    @relation(fields: [couponId], references: [id], onDelete: Restrict)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([couponId, redeemedAt])
  @@index([workspaceId, redeemedAt])
}

model AnalyticsEvent {
  id          String             @id @default(cuid())
  siteId      String
  type        AnalyticsEventType
  blockKey    String?
  visitorHash String?
  occurredAt  DateTime           @default(now())
  site        Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, occurredAt])
  @@index([siteId, blockKey, occurredAt])
  @@index([occurredAt])
}

model AuditLog {
  id          String     @id @default(cuid())
  actorUserId String?
  workspaceId String?
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime   @default(now())
  actor       User?      @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}

model LandingContent {
  id        String   @id @default(cuid())
  section   String   @unique
  content   Json
  isVisible Boolean  @default(true)
  position  Int      @default(0)
  updatedAt DateTime @updatedAt
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model DataRequest {
  id          String            @id @default(cuid())
  userId      String
  type        DataRequestType
  status      DataRequestStatus @default(REQUESTED)
  requestedAt DateTime          @default(now())
  completedAt DateTime?
  notes       String?
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt])
  @@index([status, requestedAt])
}
