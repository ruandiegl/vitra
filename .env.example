# PostgreSQL
DATABASE_URL="postgresql://vitra:change-me@localhost:5432/vitra?schema=public"

# Gere com: openssl rand -base64 32
AUTH_SECRET="replace-with-at-least-32-random-characters"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Política inicial: TRIAL | FREE | PAID
ACCESS_POLICY="TRIAL"
TRIAL_DAYS="7"

# SMTP opcional; sem SMTP, e-mails são apenas registrados no console do servidor em desenvolvimento
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Vitra <no-reply@example.com>"

# local (somente desenvolvimento) ou s3
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR="public/uploads"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# development ou production; o provedor development nunca movimenta dinheiro
PAYMENT_PROVIDER="development"
PAYMENT_WEBHOOK_SECRET="replace-in-production"
PAYMENT_API_KEY=""
PAYMENT_API_BASE_URL=""

# Somente para seed administrativo; nunca reutilize uma senha real
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# Sal diário para anonimização de visitantes; use um segredo aleatório em produção
ANALYTICS_SALT="replace-with-random-secret"
